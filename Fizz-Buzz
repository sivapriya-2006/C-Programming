#include <stdio.h>

int main() {
    int limit;
    printf("Enter the limit to run FizzBuzz up to: ");
    if (scanf("%d", &limit) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    for (int i = 1; i <= limit; i++) {
        if (i % 3 == 0 && i % 5 == 0) {
            printf("FizzBuzz\n");
        } 
        else if (i % 3 == 0) {
            printf("Fizz\n");
        } 
        else if (i % 5 == 0) {
            printf("Buzz\n");
        } 
        else {
            printf("%d\n", i);
        }
    }
    
    return 0;
}
