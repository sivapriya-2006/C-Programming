#include <stdio.h>

void reverseArray(int *arr, int size) {
    int *start = arr;          // Pointer to the beginning of the array
    int *end = arr + size - 1; // Pointer to the end of the array
    int temp;

    // Swap elements until the two pointers meet or cross
    while (start < end) {
        temp = *start;
        *start = *end;
        *end = temp;

        start++; // Move forward
        end--;   // Move backward
    }
}

int main() {
    int n;

    printf("Enter the number of elements in the array: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    reverseArray(arr, n);

    printf("\nReversed array elements:\n");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
