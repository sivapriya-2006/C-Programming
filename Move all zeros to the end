#include <stdio.h>

void moveZeros(int arr[], int n) {
    int insertPos = 0;

    for (int i = 0; i < n; i++) {
        if (arr[i] != 0) {
            arr[insertPos++] = arr[i];
        }
    }

    while (insertPos < n) {
        arr[insertPos++] = 0;
    }
}

int main() {
    int arr[] = {0, 1, 0, 3, 12};
    int n = sizeof(arr) / sizeof(arr[0]);

    moveZeros(arr, n);

    printf("Output: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    return 0;
}
