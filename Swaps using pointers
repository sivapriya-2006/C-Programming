#include <stdio.h>

void swap(int *a, int *b) {
    int temp;
    temp = *a;
    *a = *b;
    *b = temp;
}

int main() {
    int num1, num2;

    printf("Enter two integers: ");
    scanf("%d %d", &num1, &num2);

    printf("\nBefore Swapping:\n");
    printf("Number 1 = %d, Number 2 = %d\n", num1, num2);

    swap(&num1, &num2);

    printf("\nAfter Swapping:\n");
    printf("Number 1 = %d, Number 2 = %d\n", num1, num2);

    return 0;
}
